<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WFMarketReporter.MainPage">

    <ScrollView>
        <VerticalStackLayout>
            <Label
                Text="Riven Price Calculator"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />
			<VerticalStackLayout>
				
			
			<VerticalStackLayout.GestureRecognizers>
				<PointerGestureRecognizer PointerEntered="RivenModPointerEnter"
										  PointerExited="RivenModPointerLeave" />
				</VerticalStackLayout.GestureRecognizers>
				<Image x:Name="RivenModFrameTop"
					   Aspect="Center"
					   Source="riven_mod_frame_top.png" />
				<Image x:Name="RivenModFrameBottom"
					   Aspect="Center"
					   Source="riven_mod_frame_bottom.png"  />
			</VerticalStackLayout>
		</VerticalStackLayout>
    </ScrollView>

</ContentPage>
